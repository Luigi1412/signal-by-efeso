OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_ESCALATION_ENABLED=false
# Set only after a real authorized user has completed first login:
SIGNAL_BENCHMARK_WORKSPACE_ID=
SIGNAL_BENCHMARK_EMAIL=
