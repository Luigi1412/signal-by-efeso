# SIGNAL REAL — copy through npm run setup:local; fill secrets only in ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
ALLOWED_EMAIL_DOMAINS=efeso.com
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
DEMO_MODE=false
DEMO_AUTH_MODE=false
SIGNAL_ALLOW_MOCK_FALLBACK=false
SIGNAL_LOCAL_PREVIEW=0
EXTERNAL_RESEARCH_ENABLED=true
EXTERNAL_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
RESEARCH_WORKER_ENABLED=true
RESEARCH_WORKER_POLL_MS=5000
LANGUAGE_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EXTRACTION_MODEL=
