# SIGNAL v1.0 — development profile (no secrets)
# Copy to .env.local for local work.

NODE_ENV=development
DEMO_MODE=true
DEMO_AUTH_MODE=true
DEMO_AUTH_PASSWORD=signal-demo-local-only

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ALLOWED_EMAIL_DOMAINS=efeso.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

LANGUAGE_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EXTRACTION_MODEL=
OLLAMA_VALIDATION_MODEL=
OLLAMA_GENERATION_MODEL=

EXTERNAL_RESEARCH_ENABLED=true
EXTERNAL_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=

RESEARCH_WORKER_ENABLED=true
RESEARCH_WORKER_POLL_MS=5000

SIGNAL_ALLOW_MOCK_FALLBACK=true
CONTROLLED_EXTRACTION_ENABLED=false
