# SIGNAL — local / hosted Supabase
# Copy to .env.local. Never commit real secrets.

# Public (browser + server). Local default is the Supabase CLI API URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key: obtain from the selected Supabase project or local `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC. NEVER import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Product demo switch. Production must set DEMO_MODE=false.
DEMO_MODE=false

# Local/demo only. When true, demo member/admin buttons provision synthetic @efeso.com accounts.
# Requires DEMO_MODE=false. When false, that CTA does not silently authenticate.
DEMO_AUTH_MODE=false

# Public application URL (used in production checks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Research worker (separate process: npm run worker:research)
RESEARCH_WORKER_ENABLED=true
RESEARCH_WORKER_POLL_MS=5000

# Local demo password for synthetic accounts demo.member@efeso.com / demo.admin@efeso.com (server-only).
DEMO_AUTH_PASSWORD=

# Comma-separated list of corporate email domains allowed to access Signal.
# Server-side only. Domain alone is NOT enough — email must also be in workspace_authorized_emails.
ALLOWED_EMAIL_DOMAINS=efeso.com

# Optional Google OAuth via Supabase. Requires Google provider configured in Supabase Auth.
# When false/unset, login uses magic link / email (and demo buttons when DEMO_AUTH_MODE=false).
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Development/demo only. Ignored when NODE_ENV=production (production never silently uses mock data).
SIGNAL_ALLOW_MOCK_FALLBACK=false

# Default local intelligence. Server-side only. NEVER NEXT_PUBLIC.
LANGUAGE_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EXTRACTION_MODEL=
OLLAMA_VALIDATION_MODEL=
OLLAMA_GENERATION_MODEL=
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_MAX_CONCURRENT_REQUESTS=1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3000

# Optional OpenAI. Unused when LANGUAGE_MODEL_PROVIDER=ollama.
# Server-only. NEVER prefix with NEXT_PUBLIC. NEVER import into client components.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_VALIDATION_MODEL=gpt-6.1-sol
OPENAI_ESCALATION_MODEL=gpt-6-astra
OPENAI_ESCALATION_ENABLED=false

# Internal controlled extraction lab. Keep false in production unless explicitly enabling.
CONTROLLED_EXTRACTION_ENABLED=false
CONTROLLED_EXTRACTION_MAX_BYTES=15728640
CONTROLLED_EXTRACTION_MAX_PAGES=50

# Sprint 10 — bounded public company research. Server-only. NEVER NEXT_PUBLIC.
# Never commit real keys. TAVILY_API_KEY is server-side only.
# Provider: tavily | http | none | fake  (fake is tests/admin lab only; never silent in CEO UX)
EXTERNAL_RESEARCH_ENABLED=true
EXTERNAL_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXTERNAL_RESEARCH_MAX_QUERIES=10
EXTERNAL_RESEARCH_MAX_RESULTS_PER_QUERY=6
EXTERNAL_RESEARCH_MAX_ACCEPTED_SOURCES=24
RESEARCH_INITIAL_ACCEPTED_SOURCE_LIMIT=6
RESEARCH_ENRICHMENT_SOURCE_LIMIT=10
EXTERNAL_RESEARCH_MAX_BYTES_PER_SOURCE=4194304
EXTERNAL_RESEARCH_MAX_TOTAL_BYTES=29360128
EXTERNAL_RESEARCH_MAX_REDIRECTS=3
EXTERNAL_RESEARCH_FETCH_TIMEOUT_MS=8000
EXTERNAL_RESEARCH_TIME_HORIZON_MONTHS=24
EXTERNAL_RESEARCH_MAX_CONCURRENT_RUNS=1
EXTERNAL_RESEARCH_MAX_RUNS_PER_USER_HOUR=6

# Bounded execution / freshness (same model used across tasks unless explicitly overridden)
RESEARCH_PHASE_TIMEOUT_MS=900000
RESEARCH_SNAPSHOT_TTL_HOURS=12
RESEARCH_MAX_FIT_CANDIDATES=6
OLLAMA_NUM_THREADS=2
OLLAMA_KEEP_ALIVE=2m
OLLAMA_ALLOW_MULTIPLE_MODELS=false

# QA is opt-in and never part of the real product startup.
SIGNAL_LOCAL_PREVIEW=0
