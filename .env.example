# SIGNAL — local / hosted Supabase
# Copy to .env.local. Never commit real secrets.

# Public (browser + server). Local default is the Supabase CLI API URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe for the browser). Local default is the well-known CLI demo JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. NEVER prefix with NEXT_PUBLIC. NEVER import into client components.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local/demo only. When true, "Continue with EFESO account" creates a real Supabase Auth session.
# When false, that CTA does not silently authenticate.
DEMO_AUTH_MODE=true

# Local demo password for mariana@efeso.demo (server-only). Change in any shared environment.
DEMO_AUTH_PASSWORD=signal-demo-local-only

# Development/demo only. Ignored when NODE_ENV=production (production never silently uses mock data).
# SIGNAL_ALLOW_MOCK_FALLBACK=true
