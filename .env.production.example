# SIGNAL v1.0 — production profile (no secrets)
# Fill real values in the host secret store. Never commit secrets.

NODE_ENV=production
DEMO_MODE=false
DEMO_AUTH_MODE=false

# Required — fail closed without these
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAIL_DOMAINS=efeso.com
NEXT_PUBLIC_APP_URL=https://signal.example.internal

# Auth (Supabase Auth + email allowlist)
# Domain alone is insufficient. Pre-authorize emails:
#   npm run user:provision -- --email user@efeso.com --role member|admin
# Magic link is the default path. Google is optional and never bypasses allowlist.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Research
EXTERNAL_RESEARCH_ENABLED=true
EXTERNAL_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Local language model (Ollama may run outside the app container)
LANGUAGE_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EXTRACTION_MODEL=
OLLAMA_VALIDATION_MODEL=
OLLAMA_GENERATION_MODEL=

# Worker (separate process)
RESEARCH_WORKER_ENABLED=true
RESEARCH_WORKER_POLL_MS=5000

# Storage
# Source snapshots persist in the database; lab uploads use the source-files bucket when present.

# OpenAI remains optional / not funded
# OPENAI_API_KEY=

SIGNAL_ALLOW_MOCK_FALLBACK=false
CONTROLLED_EXTRACTION_ENABLED=false

# Bounded execution / freshness (same model used across tasks unless explicitly overridden)
RESEARCH_PHASE_TIMEOUT_MS=900000
RESEARCH_SNAPSHOT_TTL_HOURS=12
RESEARCH_MAX_FIT_CANDIDATES=6
OLLAMA_NUM_THREADS=2
OLLAMA_KEEP_ALIVE=2m
OLLAMA_ALLOW_MULTIPLE_MODELS=false
